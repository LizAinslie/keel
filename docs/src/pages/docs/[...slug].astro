---
import Docs from "../../layouts/Docs.astro"
import { allDocs, CATEGORIES } from "../../lib/docs"
import { render } from "astro:content"

export async function getStaticPaths() {
  const entries = await allDocs()
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[index - 1] ?? null,
      next: entries[index + 1] ?? null,
    },
  }))
}

const { entry, prev, next } = Astro.props
const { Content, headings } = await render(entry)
const category = CATEGORIES.find((item) => item.id === entry.data.category)
const toc = (headings ?? []).filter((heading) => heading.depth === 2)
---

<Docs title={entry.data.title} description={entry.data.description} currentId={entry.id}>
  <div class="breadcrumbs text-sm mb-6">
    <ul>
      <li><a href="/docs">Docs</a></li>
      <li>
        <a href="/docs">{category?.label}</a>
      </li>
      <li>{entry.data.title}</li>
    </ul>
  </div>
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-base-content/60">{category?.label}</p>
  <h1 class="mt-3 font-display text-4xl sm:text-5xl">{entry.data.title}</h1>
  <p class="mt-4 text-lg text-base-content/70">{entry.data.description}</p>
  {
    toc.length > 1 && (
      <nav class="mt-8 rounded-box border border-base-300 bg-base-200 px-5 py-4" aria-label="On this page">
        <p class="font-mono text-xs uppercase tracking-widest text-base-content/55">On this page</p>
        <ol class="mt-3 grid gap-1.5 text-sm">
          {toc.map((heading) => (
            <li>
              <a class="link link-hover" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <article class="prose-keel mt-10">
    <Content />
  </article>
  <nav class="mt-16 grid gap-3 sm:grid-cols-2" aria-label="Docs pagination">
    {
      prev ? (
        <a class="rounded-box border border-base-300 bg-base-200 px-4 py-4 min-h-14 transition-colors duration-150 hover:bg-base-100" href={`/docs/${prev.id}`}>
          <p class="font-mono text-xs uppercase tracking-widest text-base-content/60">Previous</p>
          <p class="font-medium mt-1">{prev.data.title}</p>
        </a>
      ) : (
        <span></span>
      )
    }
    {
      next && (
        <a class="rounded-box border border-base-300 bg-base-200 px-4 py-4 min-h-14 sm:text-right transition-colors duration-150 hover:bg-base-100" href={`/docs/${next.id}`}>
          <p class="font-mono text-xs uppercase tracking-widest text-base-content/60">Next</p>
          <p class="font-medium mt-1">{next.data.title}</p>
        </a>
      )
    }
  </nav>
</Docs>
