---
import LangToggle from "./LangToggle.astro"

interface Props {
  compact?: boolean
}

const compact = Astro.props.compact === true
---

<div class:list={["flex flex-wrap items-end gap-x-6 gap-y-3", compact ? "py-3" : "py-1"]}>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs tracking-[0.16em] text-base-content/55 uppercase">Frontend</span>
    <div class="join" role="radiogroup" aria-label="Frontend framework">
      <input
        class="join-item btn btn-sm min-h-10"
        type="radio"
        name="keel-frontend"
        data-pref="frontend"
        value="svelte"
        aria-label="Svelte"
        checked
      />
      <input
        class="join-item btn btn-sm min-h-10"
        type="radio"
        name="keel-frontend"
        data-pref="frontend"
        value="react"
        aria-label="React"
      />
    </div>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs tracking-[0.16em] text-base-content/55 uppercase">Backend</span>
    <div class="join" role="radiogroup" aria-label="Backend framework">
      <input
        class="join-item btn btn-sm min-h-10"
        type="radio"
        name="keel-backend"
        data-pref="backend"
        value="ktor"
        aria-label="Ktor"
        checked
      />
      <div class="tooltip tooltip-bottom" data-tip="More hosts later — same page ids">
        <input
          class="join-item btn btn-sm min-h-10"
          type="radio"
          name="keel-backend"
          data-pref="backend"
          value="soon"
          aria-label="Later"
          disabled
        />
      </div>
    </div>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs tracking-[0.16em] text-base-content/55 uppercase">Language</span>
    <LangToggle size="sm" />
  </div>
  {
    !compact && (
      <p class="max-w-xs text-xs leading-relaxed text-base-content/55 sm:ml-auto sm:text-right">
        Examples follow these selectors. React is sketched so the switch already works. More backends later.
      </p>
    )
  }
</div>
