---
import { groupedDocs } from "../lib/docs"
import type { CollectionEntry } from "astro:content"
import { path } from "../lib/paths"

interface Props {
  entries: CollectionEntry<"docs">[]
  currentId?: string
}

const groups = groupedDocs(Astro.props.entries)
const currentId = Astro.props.currentId

const icons: Record<string, string> = {
  "getting-started": "M5 19V6.2c0-.3.2-.6.5-.7L12 3l6.5 2.5c.3.1.5.4.5.7V19l-7-2.5L5 19z",
  "core-concepts": "M12 3 4 7.5 12 12l8-4.5L12 3zm-8 9 8 4.5 8-4.5M4 16.5 12 21l8-4.5",
  advanced: "M13 3 4.5 14h7L11 21l8.5-11h-7L13 3z",
  implementing: "M4 7h16M4 12h10M4 17h7",
}
---

<ul class="menu menu-sm keel-docs-menu w-full gap-0 px-2 py-3 text-base leading-snug">
  {
    groups.map((group) => (
      <li class="mt-3 first:mt-0">
        <h2 class="menu-title flex flex-row items-center gap-2 px-2 py-1.5 font-sans text-sm font-bold normal-case tracking-normal text-base-content opacity-100">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0 stroke-current fill-none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
            <path d={icons[group.id]}></path>
          </svg>
          {group.label}
        </h2>
        <ul class="mt-0">
          {group.pages.map((page) => (
            <li>
              <a
                href={path(`/docs/${page.id}`)}
                class:list={[
                  "min-h-0 justify-start text-start py-1.5",
                  page.id === currentId && "menu-active bg-base-100 font-medium",
                ]}
              >
                {page.data.title}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
