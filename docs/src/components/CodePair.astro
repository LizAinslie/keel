---
import ShikiCode from "./ShikiCode.astro"
import LangToggle from "./LangToggle.astro"

interface Props {
  ts: string
  js?: string
  title?: string
  fw?: string
  bw?: string
}

const { ts, js = ts, title, fw = "all", bw = "all" } = Astro.props
---

<figure
  class="keel-code not-prose my-5 overflow-hidden rounded-box border-2 border-base-300"
  data-fw={fw}
  data-bw={bw}
>
  <figcaption class="flex items-center justify-between gap-2 border-b-2 border-base-300 bg-base-200 px-3 py-2">
    <span class="truncate font-mono text-xs tracking-wide opacity-80">{title ?? "example"}</span>
    <div class="flex items-center gap-1">
      <LangToggle scope="block" />
      <button type="button" class="btn btn-ghost btn-xs" data-copy>Copy</button>
    </div>
  </figcaption>
  <div data-lang-panel="ts">
    <ShikiCode code={ts} lang="ts" />
  </div>
  <div data-lang-panel="js">
    <ShikiCode code={js} lang="js" />
  </div>
</figure>
