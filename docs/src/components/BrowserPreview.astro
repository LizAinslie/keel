---
interface Props {
  url?: string
}

const { url = "http://localhost:8080/" } = Astro.props
---

<div class="mockup-browser h-full w-full overflow-hidden border-2 border-base-300 bg-base-300">
  <div class="mockup-browser-toolbar">
    <div class="input border-base-100">{url}</div>
  </div>
  <div class="min-h-72 bg-base-100 sm:min-h-80 lg:min-h-96">
    <header class="flex items-center justify-between border-b-2 border-base-300 px-5 py-3">
      <div class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-field bg-primary text-primary-content" aria-hidden>
          <svg viewBox="0 0 32 32" class="size-3 fill-current"><path d="M12 2h8v14l6 12H6l6-12z"></path></svg>
        </span>
        <span class="font-display text-lg tracking-tight">Harbor</span>
      </div>
      <span class="font-mono text-xs uppercase tracking-widest text-base-content/50">Home</span>
    </header>
    <div class="px-5 py-8 sm:px-7 sm:py-10">
      <p class="font-mono text-xs uppercase tracking-widest text-base-content/50">Typed seed</p>
      <h2 class="mt-2 font-display text-4xl sm:text-5xl">Hello</h2>
      <p class="mt-4 max-w-sm text-base text-base-content/70">
        A greeting from Ktor. This pack is just a page — routes and data stay on the host.
      </p>
      <button type="button" class="btn btn-primary pointer-events-none mt-8">Open notes</button>
    </div>
  </div>
</div>
