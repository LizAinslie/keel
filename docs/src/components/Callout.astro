---
interface Props {
  title?: string
}

const { title } = Astro.props
---

<aside class="alert my-6 items-start border border-base-300 bg-base-200 text-base-content">
  <div class="text-sm leading-relaxed">
    {title && <p class="font-medium">{title}</p>}
    <div class:list={[title && "mt-1", "text-base-content/75"]}>
      <slot />
    </div>
  </div>
</aside>
