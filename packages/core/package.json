{
  "name": "@kolektiv/keel",
  "version": "0.0.2-SNAPSHOT.1",
  "description": "Keel host router — visits, seed, history, prefetch.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://repo.yuri.capital/repository/keel-npm/"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
