{
  "name": "@kolektiv/keel-pack",
  "version": "0.1.0",
  "description": "Zip a Keel pack dist into a .feb archive, and a Vite plugin to discover pages.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "keel-pack": "./keel-pack.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./svelte": {
      "types": "./src/svelte.ts",
      "import": "./src/svelte.ts",
      "default": "./src/svelte.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "vite": "^6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
