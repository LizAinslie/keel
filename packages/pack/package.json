{
  "name": "@kolektiv/keel-pack",
  "version": "0.1.0",
  "description": "Zip a Keel pack dist into a .feb archive, scaffold packs from /__keel/schema, and a Vite plugin to discover pages.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://repo.yuri.capital/repository/keel-npm/"
  },
  "bin": {
    "keel-pack": "./dist/cli.js",
    "keel-scaffold": "./dist/scaffold-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "vite": "^6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
