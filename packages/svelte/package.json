{
  "name": "@kolektiv/keel-svelte",
  "version": "0.0.2-SNAPSHOT.1",
  "description": "Keel Svelte 5 bindings — Link, Form, Head, page(), useForm, useAction.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://repo.yuri.capital/repository/keel-npm/"
  },
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "svelte": "./dist/mount.js",
      "import": "./dist/mount.js",
      "default": "./dist/mount.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "svelte": "./dist/bootstrap.js",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "svelte-package -i src -o dist",
    "build": "svelte-package -i src -o dist",
    "prepare": "pnpm build",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@kolektiv/keel": "workspace:*",
    "@tanstack/query-core": "^5.0.0",
    "@tanstack/svelte-query": "^5.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@kolektiv/keel": "workspace:*",
    "@sveltejs/package": "^2.3.11",
    "@tanstack/query-core": "^5.66.0",
    "@tanstack/svelte-query": "^5.66.0",
    "svelte": "^5.16.0",
    "typescript": "^5.7.0"
  }
}
